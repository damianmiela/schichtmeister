# Dependencies
node_modules/
.pnp/
.pnp.js

# Next.js
.next/
out/
build/

# Production
dist/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Prisma
prisma/*.db
prisma/*.db-journal

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
.nyc_output/

# Misc
*.log
*.local

# Deploy: only these versioned scripts (keep server-specific files out of deploy/)
deploy/*
!deploy/post-receive
!deploy/demo-anonymize.sql
!deploy/demo-reset.sh

# Local documentation (not deployed) — fully ignored, including the
# prüfstand sweep harness and its LEDGER (kept off git per user's
# decision — the post-receive deploy hook means any push triggers a
# deploy, which we don't want for benchmark output).
_LOCAL_DOCS/

# Generator debug logs (root-level only, not src/app/api/generate-logs)
/generate-logs/

# Solver debug data (exported JSONs, scoring scripts, analysis)
debug/

# Activity & system log data (keep folder via .gitkeep, ignore runtime files)
/logs/*.jsonl

# Python
__pycache__/
*.pyc
.pytest_cache/
pytest-cache-files-*/
