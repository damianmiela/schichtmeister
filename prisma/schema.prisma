// Prisma schema — MVP domain (see _LOCAL_DOCS/#MVP_SPEC.md)

generator client {
  provider      = "prisma-client-js"
  // Alpine (node:*-alpine) uses musl + OpenSSL 3; without this, runtime fails with libssl.so.1.1 missing
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PLANNER
  DEMO
}

enum ContractType {
  FULL_TIME
  PART_TIME
  MINI_JOB
  AUSBILDUNG
}

enum ShiftType {
  EARLY
  LATE
  NIGHT
  BL
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  KRANK
  LANGZEITKRANK
  MUTTERSCHUTZ
  URLAUB
  KUR
}

enum AbsenceType {
  KRANK
  URLAUB
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

enum TargetHoursPeriod {
  WEEKLY
  MONTHLY
}

enum WishPriority {
  NORMAL
  STRONG
}

enum WishStatus {
  OPEN
  FULFILLED
  NOT_FULFILLED
}

enum SwapStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model Facility {
  id                      String   @id @default(cuid())
  name                    String
  minRestHours            Decimal  @default(11) @db.Decimal(4, 2)
  miniJobMaxMonthlyHours  Decimal  @default(520) @db.Decimal(8, 2)
  maxSolveTimeSeconds     Int      @default(120)
  ruleOverridesJson       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users                  User[]
  employees              Employee[]
  shiftProfiles          ShiftProfile[]
  employeeWorkProfiles   EmployeeWorkProfile[]
  staffingRequirements   StaffingRequirement[]
  schedules              Schedule[]
  qualifications         Qualification[]
  shiftMarkings          ShiftMarking[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String    @default("")
  role         UserRole
  facilityId   String
  employeeId   String?   @unique
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAssignments  Assignment[]        @relation("AssignmentCreatedBy")
  approvedSwaps       SwapRequest[]       @relation("SwapApprovedBy")
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Employee {
  id                       String              @id @default(cuid())
  facilityId               String
  firstName                String
  lastName                 String
  contractType             ContractType
  targetHours              Decimal?            @db.Decimal(8, 2)
  targetHoursPeriod        TargetHoursPeriod?
  miniJobMaxMonthlyHours   Decimal?            @db.Decimal(8, 2)
  targetHoursPercent       Decimal?            @db.Decimal(6, 2)
  workProfileId            String?
  mainStation              Int?
  assignedStations         Int[]               @default([])
  status                   EmployeeStatus      @default(ACTIVE)
  qualificationTags        String[]            @default([])
  preferredShiftTypes      ShiftType[]         @default([])
  isFullTimeBl             Boolean             @default(false)
  fixedWorkingDays         Int[]               @default([])
  maxConsecutiveDays       Int?
  shiftDistribution        Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  facility             Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  workProfile          EmployeeWorkProfile? @relation(fields: [workProfileId], references: [id], onDelete: SetNull)
  user                 User?
  availability         EmployeeAvailability[]
  assignments          Assignment[]
  wishes               Wish[]
  swapsTo              SwapRequest[] @relation("SwapToEmployee")
  qualifications       Qualification[] @relation("EmployeeQualifications")
  allowedShiftProfiles ShiftProfile[]  @relation("EmployeeAllowedShiftProfiles")
  absences             EmployeeAbsence[]
}

model EmployeeAvailability {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @db.Date
  note       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

model EmployeeWorkProfile {
  id                     String       @id @default(cuid())
  facilityId             String
  name                   String
  targetHoursPercent     Decimal      @db.Decimal(6, 2)
  contractType           ContractType
  miniJobMaxMonthlyHours Decimal?     @db.Decimal(8, 2)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  facility  Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([facilityId, name])
}

model ShiftProfile {
  id            String    @id @default(cuid())
  facilityId    String
  name          String
  shiftType     ShiftType
  startTime     String
  endTime       String
  breakMinutes  Int       @default(0)
  startTime2    String?
  endTime2      String?
  breakMinutes2 Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  facility           Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  assignments        Assignment[]
  wishes             Wish[]
  allowedByEmployees Employee[]   @relation("EmployeeAllowedShiftProfiles")

  @@unique([facilityId, name])
}

model ShiftMarking {
  id         String   @id @default(cuid())
  facilityId String
  code       String   // Short code displayed in cell (e.g. "FO", "E", "BD")
  label      String   // Human-readable label (e.g. "Fortbildung")
  color      String   @default("#757575") // Display color hex
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, code])
  @@index([facilityId, sortOrder])
}

model StaffingRequirement {
  id              String    @id @default(cuid())
  facilityId      String
  shiftType       ShiftType
  stationNumber   Int       @default(1)
  minTotalCount   Int
  maxTotalCount   Int?
  isFacilityWide  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  facility                  Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  qualificationRequirements QualificationRequirement[]

  @@unique([facilityId, shiftType, stationNumber, isFacilityWide])
}

model QualificationRequirement {
  id                    String   @id @default(cuid())
  staffingRequirementId String
  qualificationTag      String
  minCount              Int      @default(1)
  maxCount              Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  staffingRequirement StaffingRequirement @relation(fields: [staffingRequirementId], references: [id], onDelete: Cascade)

  @@unique([staffingRequirementId, qualificationTag])
}

model Schedule {
  id               String           @id @default(cuid())
  facilityId       String
  periodStart      DateTime         @db.Date
  periodEnd        DateTime         @db.Date
  status           ScheduleStatus   @default(DRAFT)
  publishedAt      DateTime?
  warningsJson     String?
  preGenWishesJson String?
  virtualPlacementsJson String?
  generationLog    String?
  scoreReport      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  currentVersionId String?

  facility    Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  versions    ScheduleVersion[]

  @@index([facilityId, periodStart, periodEnd])
}

model ScheduleVersion {
  id              String   @id @default(cuid())
  scheduleId      String
  label           String   // e.g. "Vor Neugenerierung", "Manuell gesichert"
  assignmentsJson String   @db.Text // Full assignment array as JSON
  assignmentCount Int
  warningCount    Int?     // Number of validation warnings at snapshot time (null for versions created before this field existed)
  contentHash     String   // SHA-256 of sorted assignments for dedup
  scoreReport     String?
  generationLog   String?
  createdAt       DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, createdAt])
  @@index([scheduleId, contentHash])
}

model Assignment {
  id              String   @id @default(cuid())
  scheduleId      String
  date            DateTime @db.Date
  shiftProfileId  String
  employeeId      String
  createdByUserId String
  stationNumber   Int?
  markingRow2     String?
  markingRow3     String?
  dayStatus       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedule     Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shiftProfile ShiftProfile @relation(fields: [shiftProfileId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  swapsFrom    SwapRequest[] @relation("SwapFromAssignment")

  @@index([scheduleId, date])
  @@index([employeeId, date])
}

model Wish {
  id               String       @id @default(cuid())
  employeeId       String
  date             DateTime     @db.Date
  shiftType        ShiftType?
  shiftProfileId   String?
  priority         WishPriority @default(NORMAL)
  status           WishStatus   @default(OPEN)
  note             String?
  decisionReason   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftProfile ShiftProfile? @relation(fields: [shiftProfileId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([date, status])
}

model SwapRequest {
  id                     String     @id @default(cuid())
  fromAssignmentId       String     @unique
  toEmployeeId           String?
  status                 SwapStatus @default(REQUESTED)
  plannerDecisionReason  String?
  approvedByUserId       String?
  approvedAt             DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  fromAssignment Assignment @relation("SwapFromAssignment", fields: [fromAssignmentId], references: [id], onDelete: Cascade)
  toEmployee     Employee?  @relation("SwapToEmployee", fields: [toEmployeeId], references: [id], onDelete: SetNull)
  approvedBy     User?      @relation("SwapApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String      @id @default(cuid())
  entityType  String
  entityId    String
  action      AuditAction
  before      Json?
  after       Json?
  actorUserId String
  createdAt   DateTime    @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Qualification {
  id           String   @id @default(cuid())
  facilityId   String
  name         String
  abbreviation String
  color        String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility  Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  employees Employee[] @relation("EmployeeQualifications")

  @@unique([facilityId, name])
  @@unique([facilityId, abbreviation])
}

model EmployeeAbsence {
  id         String      @id @default(cuid())
  employeeId String
  type       AbsenceType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate, endDate])
}
