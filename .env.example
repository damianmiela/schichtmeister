# Database Configuration
DATABASE_URL=postgresql://planner_user:your_secure_password_here@postgres:5432/schichtmeister_planner
POSTGRES_DB=schichtmeister_planner
POSTGRES_USER=planner_user
POSTGRES_PASSWORD=your_secure_password_here

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Sign-up is closed while this is unset. Set it to require this password for new accounts.
# REGISTER_SECRET=

# SMTP Configuration (for password reset emails)
# Point to your Poste.io or any SMTP server
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM=Demo-Einrichtung Dienst Planner <noreply@yourdomain.com>
